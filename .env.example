# ── Supabase ──────────────────────────────────────────────────────────────────
# Find all three values in: Supabase Dashboard → Project Settings → API

SUPABASE_URL=          # Project URL  (e.g. https://xxxx.supabase.co)
SUPABASE_SERVICE_KEY=  # service_role secret key — backend only, never expose to browser
SUPABASE_ANON_KEY=     # anon / public key — safe for browser

# JWT secret for server-side token verification
# Find in: Supabase Dashboard → Project Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=

# ── LandingAI ─────────────────────────────────────────────────────────────────
LANDINGAI_API_KEY=

# Set to true to skip real LandingAI API calls and return plausible fake extraction data.
# Use this when the account is on the free plan or during UI/pipeline testing.
MOCK_ADE=false

# ── LLM / AI ──────────────────────────────────────────────────────────────────
# Groq — used for all LLM calls (classification, reasoning, chat)
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=

# OpenAI — used ONLY for text embeddings (Groq does not provide an embeddings API)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

